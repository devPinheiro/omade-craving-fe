# Paystack Configuration
# Get your keys from: https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
VITE_PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# App Configuration
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001/api

# Optional: Environment
VITE_ENVIRONMENT=development

# Newsletter: backend must implement POST /api/v1/newsletter/subscribe { "email": "..." }
# Use Resend, Mailchimp, or Buttondown server-side; do not expose API keys in the client.